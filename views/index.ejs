<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= profile.name %> — B.Tech Student & Developer.">
<title><%= profile.name %> — Portfolio</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<script>
tailwind.config = {
  theme: {
    extend: {
      fontFamily: { 
        sans: ['Inter', 'sans-serif'], 
        mono: ['JetBrains Mono', 'monospace'],
        display: ['Inter', 'sans-serif'] // using Inter with tight tracking for display
      },
      colors: { 
        'bg-base': '#f9fafb',
        'bg-raised': '#ffffff',
        'bg-subtle': '#f3f4f6',
        'border-strong': '#e5e7eb',
        'text-main': '#111827',
        'text-muted': '#6b7280',
        'accent': '#FF6B2B',
        'accent-dark': '#e85b1f',
        'emerald': '#047857'
      },
      boxShadow: {
        'brutal': '8px 8px 0px 0px rgba(229, 231, 235, 1)',
        'brutal-hover': '4px 4px 0px 0px rgba(229, 231, 235, 1)',
      }
    }
  }
}
</script>

<style>
  ::selection { background-color: #FF6B2B; color: white; }
  .grid-pattern {
    background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
</head>

<body class="bg-bg-base text-text-main font-sans antialiased min-h-screen flex flex-col">

<!-- HEADER -->
<header class="sticky top-0 z-40 bg-white/95 border-b border-border-strong backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between px-5 sm:px-8 lg:px-12">
    <a href="#" class="flex items-center gap-3 font-semibold tracking-tight text-lg">
      <span class="w-8 h-8 bg-text-main text-white flex items-center justify-center rounded-sm font-mono text-xs"><%= profile.name.substring(0, 2).toUpperCase() %></span>
      <span><%= profile.name %></span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-text-muted">
      <a href="#work" class="hover:text-text-main transition-colors">Projects</a>
      <a href="#coding" class="hover:text-text-main transition-colors">Profiles</a>
      <a href="#about" class="hover:text-text-main transition-colors">About</a>
      <a href="#contact" class="hover:text-text-main transition-colors">Contact</a>
    </nav>
    <a href="#contact" class="inline-flex h-9 items-center justify-center bg-accent text-white px-4 text-sm font-semibold rounded-sm hover:bg-accent-dark transition-colors">Connect</a>
  </div>
</header>

<main class="flex-1">

<!-- HERO -->
<section class="relative border-b border-border-strong overflow-hidden">
  <!-- Scan lines / Technical watermark -->
  <div class="absolute inset-0 grid-pattern opacity-40 pointer-events-none" aria-hidden="true"></div>
  <span class="absolute top-8 right-8 font-mono text-[10px] font-bold text-text-muted tracking-[0.2em]" aria-hidden="true">SYS / 01</span>
  
  <div class="relative mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-32 grid lg:grid-cols-[1fr_400px] gap-12">
    <div class="self-center">
      <p class="mb-7 flex items-center gap-3 font-mono text-xs font-semibold tracking-[.12em] uppercase text-text-muted">
        <span class="h-px w-8 bg-text-muted"></span> <%= profile.title %>
      </p>
      <h1 class="font-display max-w-[12ch] text-6xl sm:text-7xl lg:text-8xl leading-[0.95] font-bold tracking-tight text-text-main mb-8">
        <%= profile.name.split(' ')[0] %>.
      </h1>
      <p class="text-text-muted max-w-xl text-lg sm:text-xl leading-relaxed mb-10">
        <%= profile.introduction %>
      </p>
      <div class="flex items-center gap-4">
        <a href="#work" class="inline-flex h-12 items-center justify-center bg-text-main text-white px-6 font-semibold rounded-sm hover:bg-gray-800 transition-colors">
          View Projects
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"></path></svg>
        </a>
        <a href="#coding" class="inline-flex h-12 items-center justify-center border border-border-strong bg-white px-6 font-semibold rounded-sm hover:bg-bg-subtle transition-colors">
          Coding Stats
        </a>
      </div>
    </div>

    <!-- Right Side Profile & Terminal Card -->
    <div class="self-center hidden lg:block border border-border-strong bg-bg-raised shadow-brutal transition-all hover:shadow-brutal-hover hover:translate-y-1 hover:translate-x-1">
      <div class="flex items-center justify-between gap-4 border-b border-border-strong px-5 py-3">
        <div class="flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-border-strong"></span>
          <span class="w-2 h-2 rounded-full bg-border-strong"></span>
          <span class="w-2 h-2 rounded-full bg-accent"></span>
        </div>
        <span class="font-mono text-[10px] font-bold tracking-[0.1em] text-text-muted uppercase">System Profile</span>
      </div>
      
      <!-- Profile Photo -->
      <div class="border-b border-border-strong bg-white p-2">
        <img src="/images/profile.jpg" alt="Teja Katkam" class="w-full h-80 object-cover grayscale hover:grayscale-0 transition-all duration-500 border border-border-strong">
      </div>
      
      <!-- Typing Animation Terminal -->
      <div class="p-6 sm:p-8 bg-text-main text-white relative overflow-hidden h-40">
        <div class="absolute -right-4 -top-4 text-gray-800 opacity-20">
          <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <p class="font-mono text-[10px] font-bold tracking-widest text-accent uppercase mb-4">> system.log()</p>
        <div class="font-mono text-sm leading-relaxed min-h-[4rem]">
          <span id="typing-text" class="text-gray-300"></span><span class="animate-pulse bg-accent w-2 h-4 inline-block ml-1 align-middle"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="work" class="border-b border-border-strong bg-white">
  <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12">
    <div class="mb-12 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-6">
      <div>
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-text-muted uppercase">Selected Work</p>
        <h2 class="font-display mt-4 text-4xl lg:text-5xl font-bold tracking-tight text-text-main">Featured Projects</h2>
      </div>
      <div class="flex gap-2">
        <button onclick="document.getElementById('projects-slider').scrollBy({left: -400, behavior: 'smooth'})" class="w-12 h-12 flex items-center justify-center bg-bg-base border border-border-strong hover:bg-bg-subtle transition-colors" aria-label="Previous Project">
          <svg class="w-6 h-6 text-text-main" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button onclick="document.getElementById('projects-slider').scrollBy({left: 400, behavior: 'smooth'})" class="w-12 h-12 flex items-center justify-center bg-bg-base border border-border-strong hover:bg-bg-subtle transition-colors" aria-label="Next Project">
          <svg class="w-6 h-6 text-text-main" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <div id="projects-slider" class="flex overflow-x-auto snap-x gap-px bg-border-strong border border-border-strong pb-4 scrollbar-none" style="scrollbar-width: none; -ms-overflow-style: none;">
      <% projects.forEach((project, index) => { %>
      <article class="w-full sm:min-w-[50%] lg:min-w-[33.333%] shrink-0 snap-start bg-white p-8 sm:p-10 hover:bg-bg-base transition-colors group flex flex-col">
        <div class="flex justify-between items-start mb-8">
          <div class="w-12 h-12 flex items-center justify-center bg-bg-subtle border border-border-strong rounded-sm text-text-main">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <span class="font-mono text-xs font-bold tracking-widest text-accent uppercase"><%= String(index + 1).padStart(2, '0') %></span>
        </div>
        <h3 class="font-display text-xl font-bold text-text-main mb-4 group-hover:text-accent transition-colors"><%= project.title %></h3>
        <% if (project.image) { %>
          <div class="mb-6 border border-border-strong overflow-hidden max-h-40">
            <img src="<%= project.image %>" alt="<%= project.title %> screenshot" class="w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-300">
          </div>
        <% } %>
        <p class="text-text-muted text-sm leading-relaxed mb-8 h-32 overflow-hidden">
          <%= project.description %>
        </p>
        <div class="pt-6 border-t border-border-strong flex flex-wrap gap-2 mt-auto">
          <% project.technologies.forEach(tech => { %>
          <span class="px-2 py-1 bg-bg-subtle border border-border-strong text-xs font-mono font-medium text-text-main"><%= tech %></span>
          <% }) %>
        </div>
        <% if (project.githubUrl || project.liveUrl) { %>
        <div class="pt-6 mt-6 border-t border-border-strong flex gap-4">
          <% if (project.githubUrl) { %>
            <a href="<%= project.githubUrl %>" target="_blank" class="text-sm font-bold text-text-main hover:text-accent flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          <% } %>
          <% if (project.liveUrl) { %>
            <a href="<%= project.liveUrl %>" target="_blank" class="text-sm font-bold text-text-main hover:text-accent flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              Live Demo
            </a>
          <% } %>
        </div>
        <% } %>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- CODING PROFILES -->
<section id="coding" class="border-b border-border-strong bg-bg-base">
  <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-20">
      
      <div>
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-text-muted uppercase">Algorithm & Data Structures</p>
        <h2 class="font-display mt-4 text-4xl lg:text-5xl font-bold tracking-tight text-text-main mb-6">Coding Profiles</h2>
        <p class="text-text-muted leading-relaxed">
          I actively participate in competitive programming to sharpen my problem-solving skills and master data structures and algorithms.
        </p>
      </div>

      <div class="bg-white border border-border-strong shadow-brutal">
        <div class="flex items-center justify-between border-b border-border-strong px-6 py-4 bg-bg-subtle">
          <span class="font-mono text-xs font-bold tracking-widest text-text-main uppercase flex items-center gap-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.34-4.34m2.34-5.66a8 8 0 11-16 0 8 8 0 0116 0z"></path></svg>
            Profile Scan Results
          </span>
          <span class="font-mono text-xs text-text-muted"><%= codingProfiles.length %> Profiles Found</span>
        </div>
        
        <div class="divide-y divide-border-strong">
          <% codingProfiles.forEach(profile => { %>
          <a href="<%= profile.profileUrl %>" target="_blank" class="block p-6 hover:bg-bg-base transition-colors group">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h3 class="font-bold text-lg text-text-main flex items-center gap-2">
                  <%= profile.platform %>
                  <svg class="w-4 h-4 text-text-muted opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </h3>
                <p class="font-mono text-xs text-text-muted mt-1"><%= profile.username %></p>
              </div>
              <div class="flex gap-6">
                <div class="text-right">
                  <span class="block font-mono text-xl font-bold text-text-main"><%= profile.metric1Value %></span>
                  <span class="block font-mono text-[10px] uppercase text-text-muted mt-0.5"><%= profile.metric1Label %></span>
                </div>
                <div class="text-right">
                  <span class="block font-mono text-xl font-bold text-<%= profile.color || 'emerald' %>"><%= profile.metric2Value %></span>
                  <span class="block font-mono text-[10px] uppercase text-text-muted mt-0.5"><%= profile.metric2Label %></span>
                </div>
              </div>
            </div>
          </a>
          <% }) %>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ABOUT & SKILLS -->
<section id="about" class="border-b border-border-strong bg-white">
  <div class="mx-auto max-w-[90rem] px-5 py-20 sm:px-8 lg:px-12 grid lg:grid-cols-2 gap-16">
    
    <div>
      <div class="mb-10">
        <p class="font-mono text-xs font-semibold tracking-[0.1em] text-text-muted uppercase">Technical Foundation</p>
        <h2 class="font-display mt-4 text-4xl lg:text-5xl font-bold tracking-tight text-text-main">Skills & Tools</h2>
      </div>

      <div class="space-y-6">
        <% skills.forEach(skillGroup => { %>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-text-main mb-3 border-b border-border-strong pb-2"><%= skillGroup.category %></h3>
          <div class="flex flex-wrap gap-2">
            <% skillGroup.items.forEach(item => { %>
            <span class="px-3 py-1 bg-bg-base border border-border-strong text-sm font-medium text-text-main"><%= item %></span>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>

      <div class="mt-12">
        <h3 class="text-sm font-bold uppercase tracking-wider text-text-main mb-4 border-b border-border-strong pb-2">Certifications</h3>
        <ul class="space-y-4">
          <% certifications.forEach(cert => { %>
          <li class="flex justify-between items-start">
            <div>
              <strong class="block text-text-main text-sm"><%= cert.name %></strong>
              <span class="text-xs text-text-muted"><%= cert.issuer %></span>
            </div>
            <% if(cert.date) { %>
            <span class="font-mono text-[10px] text-text-muted uppercase shrink-0"><%= cert.date %></span>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <!-- About Content -->
    <div>
      <div class="border border-border-strong bg-bg-base p-8 sm:p-10 h-full flex flex-col">
        <svg class="w-8 h-8 text-accent mb-6" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <div class="mb-6 border border-border-strong bg-white p-2">
          <img src="/images/about.jpg" alt="About Me" class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-500 border border-border-strong">
        </div>
        <h3 class="font-display text-2xl font-bold text-text-main mb-6">Background & Achievements</h3>
        <p class="text-text-muted leading-relaxed mb-6 whitespace-pre-line"><%= profile.about %></p>
        
        <h4 class="font-bold text-sm uppercase tracking-wider text-text-main mb-3">Key Achievements</h4>
        <ul class="text-sm text-text-muted space-y-3 mb-10">
          <% achievements.forEach(ach => { %>
          <li class="flex gap-2"><svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> <span><strong><%= ach.title %>:</strong> <%= ach.description %></span></li>
          <% }) %>
        </ul>
        
        <div class="mt-auto pt-8 border-t border-border-strong">
          <p class="font-mono text-[10px] font-bold tracking-widest text-text-main uppercase mb-2">Education Status</p>
          <% education.forEach(edu => { %>
          <div class="flex items-center gap-3 mt-3">
            <svg class="w-5 h-5 text-emerald shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between w-full gap-1 sm:gap-2">
              <div>
                <span class="text-sm font-semibold text-text-main"><%= edu.degree %></span>
                <span class="text-sm text-text-muted">— <%= edu.institution %> (<%= edu.duration %>)</span>
              </div>
              <% if (edu.gradeType && edu.gradeValue) { %>
                <div class="bg-bg-subtle border border-border-strong px-2 py-1 text-xs font-mono shrink-0">
                  <strong class="text-text-main"><%= edu.gradeType %>:</strong> <span class="text-text-muted"><%= edu.gradeValue %></span>
                </div>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- CONTACT SECTION (Terminal Footer) -->
<section id="contact" class="bg-text-main text-white py-20 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 grid-pattern opacity-10 pointer-events-none" aria-hidden="true"></div>
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12 relative z-10 grid lg:grid-cols-2 gap-12">
    
    <div>
      <p class="font-mono text-xs font-semibold tracking-[0.1em] text-accent uppercase">End of report</p>
      <h2 class="font-display mt-4 text-5xl lg:text-7xl font-bold tracking-tight text-white mb-6">Initiate Contact</h2>
      <p class="text-gray-400 max-w-md text-lg">
        Open for internships, roles, and collaborative projects.
      </p>
    </div>

    <div class="lg:justify-self-end w-full max-w-md border border-gray-700 bg-gray-900 p-8 shadow-[8px_8px_0px_0px_rgba(255,107,43,0.3)]">
      <div class="flex items-center gap-2 border-b border-gray-800 pb-4 mb-6">
        <span class="w-3 h-3 rounded-full bg-red-500"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
        <span class="w-3 h-3 rounded-full bg-green-500"></span>
        <span class="ml-4 font-mono text-[10px] text-gray-500 uppercase tracking-widest">Connect</span>
      </div>
      
      <div class="space-y-6">
        <a href="mailto:<%= profile.email %>" class="flex items-center gap-4 group">
          <div class="w-10 h-10 bg-gray-800 flex items-center justify-center text-gray-400 group-hover:bg-accent group-hover:text-white transition-colors border border-gray-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <span class="font-mono text-sm text-gray-300 group-hover:text-white transition-colors"><%= profile.email %></span>
        </a>

        <a href="tel:<%= profile.phone %>" class="flex items-center gap-4 group">
          <div class="w-10 h-10 bg-gray-800 flex items-center justify-center text-gray-400 group-hover:bg-accent group-hover:text-white transition-colors border border-gray-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <span class="font-mono text-sm text-gray-300 group-hover:text-white transition-colors"><%= profile.phone %></span>
        </a>

        <a href="<%= profile.linkedin %>" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group">
          <div class="w-10 h-10 bg-gray-800 flex items-center justify-center text-gray-400 group-hover:bg-accent group-hover:text-white transition-colors border border-gray-700">
