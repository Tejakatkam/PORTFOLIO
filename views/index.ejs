    <p class="text-xs text-gray-600 font-mono mt-2 sm:mt-0">Designed with Tailwind CSS</p>
  </div>
</footer>

<script>
  const phrases = [
    "AI/ML Enthusiast | Building Intelligent Real-World Solutions",
    "Problem Solver | Turning Ideas Into Scalable Applications",
    "Building With LLMs & Intelligent Systems",
    "Software Engineer in the Making | Learning, Building & Solving"
  ];
  let currentPhraseIndex = 0;
  let currentCharacterIndex = 0;
  let isDeleting = false;
  let typingDelay = 50;
  let deletingDelay = 30;
  let nextPhraseDelay = 2000;

  function type() {
    const textElement = document.getElementById('typing-text');
    if (!textElement) return;

    const currentPhrase = phrases[currentPhraseIndex];
    
    if (isDeleting) {
      textElement.innerHTML = currentPhrase.substring(0, currentCharacterIndex - 1);
      currentCharacterIndex--;
    } else {
      textElement.innerHTML = currentPhrase.substring(0, currentCharacterIndex + 1);
      currentCharacterIndex++;
    }

    let timeoutDelay = isDeleting ? deletingDelay : typingDelay;

    if (!isDeleting && currentCharacterIndex === currentPhrase.length) {
      timeoutDelay = nextPhraseDelay;
      isDeleting = true;
    } else if (isDeleting && currentCharacterIndex === 0) {
      isDeleting = false;
      currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
      timeoutDelay = 500;
    }

    setTimeout(type, timeoutDelay);
  }

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(type, 1000);
  });
</script>
</body>
</html>
